
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to all files (needed for images to show on website)
      allow read: if true;
      
      // Allow write access only to authenticated users
      // Ideally, you should check for admin role here too: 
      // allow write: if request.auth != null && request.auth.token.role == 'ADMIN';
      allow write: if request.auth != null;
    }
  }
}
